{
  "name": "my-habit-mastery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:native": "vite build --mode native",
    "lint": "eslint .",
    "preview": "vite preview",
    "cap:sync": "npm run build:native && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "apps:pull": "powershell -ExecutionPolicy Bypass -File scripts/sync-apps.ps1",
    "apps:update": "powershell -ExecutionPolicy Bypass -File scripts/sync-apps.ps1 -Update",
    "apps:local": "powershell -ExecutionPolicy Bypass -File scripts/sync-apps.ps1 -Local"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.6.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@vercel/analytics": "^1.5.0",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.15.0",
    "framer-motion": "^11.18.2",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.7.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
